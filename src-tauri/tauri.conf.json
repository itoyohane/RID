{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RID",
  "version": "0.1.1",
  "identifier": "com.rid.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "RID",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "itoyohane",
    "homepage": "https://github.com/itoyohane/RID",
    "copyright": "Copyright © 2026 itoyohane",
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Launch, close, and restore Windows apps with smart shortcuts.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    }
  }
}
